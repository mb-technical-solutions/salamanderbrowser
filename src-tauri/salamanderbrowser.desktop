[Desktop Entry]
Version=1.0
Type=Application
Name=Salamander
Name[en]=Salamander
GenericName=Web Browser
X-GNOME-FullName=Salamander
Comment=Simple Yet Powerful Anti-Detect Browser
Exec=salamanderbrowser %u
Icon=salamanderbrowser
StartupNotify=true
NoDisplay=false
Categories=Network;WebBrowser;
MimeType=x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/salamander-auth;text/html;application/xhtml+xml;
StartupWMClass=salamanderbrowser
Keywords=browser;web;internet;productivity;
